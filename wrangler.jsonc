{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "paris-dashboard-project-management",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-05-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "paris-dashboard-project-management"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}